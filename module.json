        "GITHUB_OWNER",
        "GITHUB_REPO"
      ],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "pull_number": {
          "type": "number",
          "required": true
        }
      },
      "output_schema": {
        "pull_request": "object",
        "http_status": "number"
      }
    },
