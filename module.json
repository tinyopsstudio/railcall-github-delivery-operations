{
  "id": "tinyops-studio-llc/github-delivery-operations",
  "name": "GitHub Delivery Operations - governed issues, pull requests, workflows, and files",
  "version": "1.0.0",
  "description": "Ten production-oriented GitHub delivery operations that complement RailCall's built-in issue commands. Read issues and pull requests, update work, create and review pull requests, merge with an expected SHA, dispatch Actions workflows, and create or update repository files. Credentials stay in RailCall's local vault, reads use bounded retries, and writes fail closed on ambiguous transport outcomes. Supports GitHub.com and HTTPS GitHub Enterprise API bases. contest:2026Q3",
  "provider": "github",
  "publisher_pubkey": "47e411915723b7727bad3568f592fac50d79a2f35c7ad65216fa4c93acf7f059",
  "license_required": false,
  "commands": [
    {
      "id": "github.get_issue",
      "title": "Read one GitHub issue or pull-request issue record",
      "provider": "github",
      "risk": "low",
      "mode": "read",
      "requires": [
        "GITHUB_TOKEN",
        "GITHUB_OWNER",
        "GITHUB_REPO"
      ],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "issue_number": {
          "type": "number",
          "required": true
        }
      },
      "output_schema": {
        "issue": "object",
        "http_status": "number"
      }
    },
    {
      "id": "github.update_issue",
      "title": "Update a GitHub issue title, body, or state",
      "provider": "github",
      "risk": "medium",
      "mode": "write_requires_approval",
      "requires": [
        "GITHUB_TOKEN",
        "GITHUB_OWNER",
        "GITHUB_REPO"
      ],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "issue_number": {
          "type": "number",
          "required": true
        },
        "title": {
          "type": "string",
          "required": false
        },
        "body": {
          "type": "string",
          "required": false
        },
        "state": {
          "type": "string",
          "required": false
        }
      },
      "output_schema": {
        "issue": "object",
        "http_status": "number"
      }
    },
    {
      "id": "github.add_issue_comment",
      "title": "Add a comment to a GitHub issue or pull request",
      "provider": "github",
      "risk": "medium",
      "mode": "write_requires_approval",
      "requires": [
        "GITHUB_TOKEN",
        "GITHUB_OWNER",
        "GITHUB_REPO"
      ],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "issue_number": {
          "type": "number",
          "required": true
        },
        "body": {
          "type": "string",
          "required": true
        }
      },
      "output_schema": {
        "comment_id": "number",
        "html_url": "string",
        "http_status": "number"
      }
    },
    {
      "id": "github.list_pull_requests",
      "title": "List GitHub pull requests with bounded filters",
      "provider": "github",
      "risk": "low",
      "mode": "read",
      "requires": [
        "GITHUB_TOKEN",
        "GITHUB_OWNER",
        "GITHUB_REPO"
      ],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "state": {
          "type": "string",
          "required": false
        },
        "head": {
          "type": "string",
          "required": false
        },
        "base": {
          "type": "string",
          "required": false
        },
        "sort": {
          "type": "string",
          "required": false
        },
        "direction": {
          "type": "string",
          "required": false
        },
        "per_page": {
          "type": "number",
          "required": false
        }
      },
      "output_schema": {
        "pull_requests": "array",
        "count": "number",
        "http_status": "number"
      }
    },
    {
      "id": "github.get_pull_request",
      "title": "Read one GitHub pull request and its head SHA",
      "provider": "github",
      "risk": "low",
      "mode": "read",
      "requires": [
