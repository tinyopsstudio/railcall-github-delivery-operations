      "output_schema": {
        "workflow_id": "string",
        "ref": "string",
        "http_status": "number"
      }
    },
    {
      "id": "github.put_file",
      "title": "Create or update a UTF-8 file in a GitHub repository",
      "provider": "github",
      "risk": "high",
      "mode": "write_requires_approval",
      "requires": [
        "GITHUB_TOKEN",
        "GITHUB_OWNER",
        "GITHUB_REPO"
